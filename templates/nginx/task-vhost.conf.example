# Task 1234 - generated by `ws create`. `ws rm 1234` removes it.
# Placeholders: 1234 = task number, 31234 = 30000 + task number, paths = your machine.
# Write the file, run `nginx -t`, and only `nginx -s reload` when the test passes (revert otherwise).

# Frontend: https://1234.ws.test:8443 -> the task's Next server
server {
    listen       8443 ssl;
    http2        on;
    server_name  1234.ws.test;

    ssl_certificate     /opt/homebrew/etc/nginx/certs/ws-wildcard.pem;      # mkcert "*.ws.test"
    ssl_certificate_key /opt/homebrew/etc/nginx/certs/ws-wildcard-key.pem;

    location / {
        proxy_pass          http://127.0.0.1:31234;
        proxy_http_version  1.1;
        proxy_set_header    Host              $host;
        proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto https;
        proxy_set_header    Upgrade           $http_upgrade;     # HMR websocket
        proxy_set_header    Connection        "upgrade";
        proxy_read_timeout  86400;
    }
}

# API: https://api-1234.ws.test:8443 -> shared php-fpm, document root = this task's api worktree.
# Serve it over TLS too: a browser blocks XHR from an https page to an http origin.
server {
    listen      8443 ssl;
    http2       on;
    server_name api-1234.ws.test;
    root        /Users/you/code/tasks/task-1234/api/public;

    ssl_certificate     /opt/homebrew/etc/nginx/certs/ws-wildcard.pem;
    ssl_certificate_key /opt/homebrew/etc/nginx/certs/ws-wildcard-key.pem;

    access_log /opt/homebrew/var/log/nginx/task-1234.access.log;
    error_log  /opt/homebrew/var/log/nginx/task-1234.error.log;

    index index.php;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass  127.0.0.1:9000;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include       fastcgi_params;
    }
}
